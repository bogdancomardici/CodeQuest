---
services:
  db:
    image: postgres
    restart: always
    environment:
      POSTGRES_PASSWORD: example
    volumes:
      - volumes:
  - ./postgres-data:/var/lib/postgresql/datavolumes:
  - ./postgres-data:/var/lib/postgresql/data 
  adminer:
    image: adminer
    restart: always
    ports:
      - 8080:8080
